# Required: your Anthropic API key
ANTHROPIC_API_KEY=

# Comma-separated list of allowed CORS origins.
# Use "*" for local dev. For production set to your frontend URL, e.g.:
# ALLOWED_ORIGINS=https://your-frontend.netlify.app
ALLOWED_ORIGINS=*

# Frame sampling / cost controls (optional, defaults shown)
MAX_FRAMES=20
SAMPLE_INTERVAL_SEC=1
MAX_UPLOAD_MB=100
